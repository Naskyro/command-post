worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 256;
}

http {
    access_log /dev/stdout;

    # Use /tmp so nginx can write without root
    client_body_temp_path /tmp/nginx_client_body;
    proxy_temp_path       /tmp/nginx_proxy;
    fastcgi_temp_path     /tmp/nginx_fastcgi;
    uwsgi_temp_path       /tmp/nginx_uwsgi;
    scgi_temp_path        /tmp/nginx_scgi;

    server {
        listen ${PORT};

        # Forward real client IP for per-IP rate limiting in the gateway.
        # COMMAND_AUTH_TRUST_LOCAL_PROXY_IP=true must be set in Railway env.
        proxy_set_header X-Command-Client-IP $remote_addr;

        # Strip browser-added forwarded headers; the gateway controls what goes upstream
        proxy_set_header X-Forwarded-For   "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-Host  "";

        proxy_read_timeout 65s;
        proxy_send_timeout 65s;

        location / {
            proxy_pass http://127.0.0.1:4100;
        }
    }
}
